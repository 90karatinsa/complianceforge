# Sample configuration for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/otomatik
REDIS_URL=redis://localhost:6379
# Boş bırakmayın; API anahtarlarının hashlenmesi için zorunludur.
API_KEYS_SALT=change-me
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEA+examplePlaceholderPublicKeyDontUseInProd
MAX_CONCURRENCY=5
SCAN_TIMEOUT_S=900
WEBHOOK_MAX_RETRY=5
SCAN_QUEUE_NAME=scan-jobs
ALLOW_NETWORK_FETCH=true
OCI_REGISTRY_AUTH={}
PROMETHEUS_PORT=9464
GIT_BIN=/usr/bin/git
TAR_BIN=/usr/bin/tar
UNZIP_BIN=/usr/bin/unzip
