{
  "name": "otomatik-oss-uyumluluk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "tsx": "tsx",
    "scan": "tsx cli/scan.ts",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch api/src/server.ts",
    "dev:worker": "tsx watch worker/src/worker.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest run --coverage",
    "metrics:check": "tsx scripts/metrics-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "license:check": "tsx scripts/license-compliance.ts",
    "license:request": "tsx scripts/license-manager.ts request",
    "license:install": "tsx scripts/license-manager.ts install",
    "license:status": "tsx scripts/license-manager.ts status",
    "security:scan": "tsx scripts/security-scan.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts --output dist/sbom.json",
    "compliance": "npm run license:check && npm run security:scan && npm run sbom:generate",
    "package:windows": "tsx scripts/package/windows-msi.ts",
    "package:macos": "tsx scripts/package/macos-pkg.ts",
    "package:deb": "tsx scripts/package/deb.ts",
    "package:all": "npm run package:windows && npm run package:macos && npm run package:deb",
    "perf:test": "k6 run scripts/perf/load.k6.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.911.0",
    "@fastify/swagger": "^8.11.0",
    "@fastify/swagger-ui": "^1.9.5",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/core": "^1.18.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.51.1",
    "@opentelemetry/resources": "^1.8.0",
    "@opentelemetry/sdk-trace-base": "^1.8.0",
    "@opentelemetry/sdk-trace-node": "^1.18.1",
    "@opentelemetry/semantic-conventions": "^1.23.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "keytar": "^7.9.0",
    "pg": "^8.11.3",
    "pino": "^9.13.1",
    "prom-client": "^15.1.0",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "~5.5.4",
    "vitest": "^1.5.0"
  }
}
